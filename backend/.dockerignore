# Le lien symbolique public/storage pointe vers un chemin absolu du conteneur
# (/app/storage/app/public). Docker ne sait pas l'embarquer et le build echoue
# sur « invalid file request public/storage ». Il est recree au demarrage.
public/storage

# Reinstalles dans l'image par composer install.
vendor/

# Secrets et etat local : ne doivent jamais entrer dans une image.
.env
.env.*
!.env.example
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
.phpunit.result.cache

.git/
tests/coverage/
