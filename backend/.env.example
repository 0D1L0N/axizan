APP_NAME=Axizan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Base des liens envoyes par mail (reinitialisation de mot de passe).
FRONTEND_URL=http://localhost:3000
# Le Benin est a UTC+1 sans heure d ete. Indispensable : le delai minimum
# d une heure avant livraison se calcule sur l heure locale.
APP_TIMEZONE=Africa/Porto-Novo

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=axizan
DB_USERNAME=postgres
DB_PASSWORD=postgres

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Redis — cache et file d'attente.
# predis : client ecrit en PHP pur. L'extension native phpredis n'est pas
# installable dans l'image (canal PECL casse) — voir backend/Dockerfile.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

# Moyens de paiement Mobile Money.
# Aucune API operateur n'est branchee : le client envoie l'argent a ces
# numeros puis declare sa reference, un administrateur verifie et valide.
PAY_MERCHANT_NAME=Axizán
PAY_MTN_NUMBER="+229 00 00 00 00"
PAY_MOOV_NUMBER="+229 00 00 00 00"
PAY_CELTIIS_NUMBER="+229 00 00 00 00"
PAY_MTN_ENABLED=true
PAY_MOOV_ENABLED=true
PAY_CELTIIS_ENABLED=false

# SMS — aucun agregateur contractualise. Le pilote « log » ecrit le message
# dans les journaux au lieu de l'envoyer : tout le parcours est verifiable,
# rien n'est facture, rien n'est simule. Voir config/sms.php.
SMS_DRIVER=log
SMS_FROM=AXIZAN
SMS_COUNTRY_CODE=229
