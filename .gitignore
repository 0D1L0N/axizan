# Laravel
/backend/vendor/
/backend/node_modules/
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitkeep
/backend/.phpunit.result.cache

# Lien cree par `php artisan storage:link`. Il pointe vers un chemin absolu du
# conteneur : versionne, il casse le build Docker (« invalid file request »).
/backend/public/storage

# Storage : on versionne l'OSSATURE des dossiers, jamais leur contenu.
# Sans ces .gitkeep, un clone frais demarre sans storage/framework et Laravel
# echoue sur « Please provide a valid cache path ».
/backend/storage/**
!/backend/storage/**/
!/backend/storage/**/.gitkeep

# Next.js
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/.env*
!/frontend/.env.example

# System files
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuration locale de docker compose (IP de la machine).
/.env
